# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://user:password@localhost:5432/containertrack

# ─── Cache / Queues ───────────────────────────────────────────────────────────
# Redis connection used by Bull job queues and session caching.
REDIS_URL=redis://localhost:6379

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Secret used to sign short-lived access tokens (8 h expiry).
# Must be at least 64 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-random-64-character-string

# Secret used to sign long-lived refresh tokens (7 d expiry).
# Must be different from JWT_SECRET and equally random.
JWT_REFRESH_SECRET=change-this-to-a-different-random-64-character-string

# ─── Cloudflare R2 (photo storage) ───────────────────────────────────────────
# Cloudflare account ID found in the dashboard right sidebar.
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API token Access Key ID (created under Manage R2 API Tokens).
R2_ACCESS_KEY_ID=your-r2-access-key

# R2 API token Secret Access Key paired with the above key ID.
R2_SECRET_ACCESS_KEY=your-r2-secret-key

# Name of the R2 bucket where CTPAT inspection photos are stored.
R2_BUCKET_NAME=containertrack-photos

# S3-compatible endpoint for the bucket.
# Format: https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ─── API Server ───────────────────────────────────────────────────────────────
# TCP port the Fastify server listens on.
API_PORT=3001

# Host address to bind. Use 0.0.0.0 in Docker; 127.0.0.1 for local-only.
API_HOST=0.0.0.0

# ─── Next.js / Auth.js ───────────────────────────────────────────────────────
# Secret used by Auth.js to sign session cookies.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-random-string

# Public URL of the Next.js app (no trailing slash).
# Must match the origin browsers use to reach the web app.
NEXTAUTH_URL=http://localhost:3000

# Internal URL the Next.js server uses to call the Fastify API.
# In Docker this should be the service name, e.g. http://api:3001
API_INTERNAL_URL=http://localhost:3001
