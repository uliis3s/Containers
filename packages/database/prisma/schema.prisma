generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum CategoriaCaja      { SECA MARITIMA }
enum TipoSello          { PRIMARIO SECUNDARIO }
enum TipoOperacion      { DROP PICKUP SWAP }
enum CanalOrigen        { EMAIL WHATSAPP TELEFONO PORTAL }
enum StatusSolicitud    { PENDIENTE APROBADA RECHAZADA }
enum Ubicacion          { PLANTA YARDA_EXTERNA }
enum StatusMovimiento   { AUTORIZADO EN_PLANTA CARGANDO LISTO DESPACHADO }
enum MomentoInspeccion  { ENTRADA SALIDA }
enum ResultadoInspeccion { OK REVISAR RECHAZADO }
enum TipoAlerta         { DIAS_48 DIAS_72 MEDICION_FALLIDA SELLO_NO_COINCIDE }
enum Rol                { LOGISTICA SEGURIDAD ENVIOS VENTAS TRANSPORTISTA BROKER ADMIN }

enum CategoriaFoto {
  CONDUCTOR
  PLACAS_TRACTOR
  PLACAS_CONTENEDOR
  CAJA_EXTERIOR
  SELLO_PRIMARIO
  SELLO_SECUNDARIO
  CAJA_SALIDA
}

// ─── Catálogos ────────────────────────────────────────────────────────────────

model TipoCaja {
  id           String        @id @default(cuid())
  codigo       String        @unique
  descripcion  String
  categoria    CategoriaCaja
  largoRefCm   Decimal       @db.Decimal(7, 1)
  anchoRefCm   Decimal       @db.Decimal(7, 1)
  altoRefCm    Decimal       @db.Decimal(7, 1)
  toleranciaCm Decimal       @default(2.0) @db.Decimal(5, 1)
  cajas        Caja[]
}

model Cliente {
  id               String    @id @default(cuid())
  nombre           String    @unique
  sellosRequeridos Int
  scac             String?
  caat             String?
  activo           Boolean   @default(true)
  invoices         Invoice[]
}

// ─── Entidades operativas ─────────────────────────────────────────────────────

model Broker {
  id             String          @id @default(cuid())
  nombre         String
  contacto       String?
  email          String?
  telefono       String?
  activo         Boolean         @default(true)
  transportistas Transportista[]
}

model Transportista {
  id          String          @id @default(cuid())
  brokerId    String?
  broker      Broker?         @relation(fields: [brokerId], references: [id])
  nombre      String
  contacto    String?
  email       String?
  activo      Boolean         @default(true)
  conductores Conductor[]
  tractores   Tractor[]
  cajas       Caja[]
  solicitudes Solicitud[]
  demandas    DemandaDiaria[]
}

model Conductor {
  id              String        @id @default(cuid())
  transportistaId String
  transportista   Transportista @relation(fields: [transportistaId], references: [id])
  idInterno       String?
  nombre          String
  fechaNacimiento DateTime?
  licenciaNumero  String
  visaNumero      String?
  fastNumero      String
  fotoUrl         String?
  activo          Boolean       @default(true)
  solicitudes     Solicitud[]
}

model Tractor {
  id              String        @id @default(cuid())
  transportistaId String
  transportista   Transportista @relation(fields: [transportistaId], references: [id])
  truckNumero     String
  placas          String
  activo          Boolean       @default(true)
  solicitudes     Solicitud[]
}

model Caja {
  id               String        @id @default(cuid())
  transportistaId  String
  transportista    Transportista @relation(fields: [transportistaId], references: [id])
  tipoCajaId       String
  tipoCaja         TipoCaja      @relation(fields: [tipoCajaId], references: [id])
  containerNumero  String
  placasContenedor String?
  activo           Boolean       @default(true)
  solicitudesDrop  Solicitud[]   @relation("CajaDropSolicitud")
  solicitudesPickup Solicitud[]  @relation("CajaPickupSolicitud")
}

// ─── Flujo de solicitud ───────────────────────────────────────────────────────

model Solicitud {
  id                  String          @id @default(cuid())
  transportistaId     String
  transportista       Transportista   @relation(fields: [transportistaId], references: [id])
  conductorId         String
  conductor           Conductor       @relation(fields: [conductorId], references: [id])
  tractorId           String
  tractor             Tractor         @relation(fields: [tractorId], references: [id])
  cajaDropId          String?
  cajaDrop            Caja?           @relation("CajaDropSolicitud",   fields: [cajaDropId],    references: [id])
  cajaPickupId        String?
  cajaPickup          Caja?           @relation("CajaPickupSolicitud", fields: [cajaPickupId],  references: [id])
  tipoOperacion       TipoOperacion
  canalOrigen         CanalOrigen
  status              StatusSolicitud @default(PENDIENTE)
  comentarioLogistica String?
  aprobadoPorId       String?
  aprobadoPor         Usuario?        @relation("SolicitudAprobador",  fields: [aprobadoPorId], references: [id])
  aprobadoEn          DateTime?
  creadoEn            DateTime        @default(now())
  sellos              Sello[]
  movimiento          Movimiento?
}

model Sello {
  id          String    @id @default(cuid())
  solicitudId String
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  numero      String
  tipo        TipoSello
  orden       Int
}

// ─── Movimiento en planta ─────────────────────────────────────────────────────

model Movimiento {
  id            String           @id @default(cuid())
  solicitudId   String           @unique
  solicitud     Solicitud        @relation(fields: [solicitudId], references: [id])
  lugarAsignado String?
  ubicacion     Ubicacion        @default(PLANTA)
  horaEntrada   DateTime?
  horaSalida    DateTime?
  status        StatusMovimiento @default(AUTORIZADO)
  inspecciones  Inspeccion[]
  invoices      Invoice[]
  alertas       Alerta[]
}

// ─── Inspección CTPAT ─────────────────────────────────────────────────────────

model Inspeccion {
  id                  String              @id @default(cuid())
  movimientoId        String
  movimiento          Movimiento          @relation(fields: [movimientoId], references: [id])
  guardiaId           String
  guardia             Usuario             @relation(fields: [guardiaId], references: [id])
  momento             MomentoInspeccion
  laserLargoCm        Decimal?            @db.Decimal(7, 1)
  laserAnchoCm        Decimal?            @db.Decimal(7, 1)
  laserAltoCm         Decimal?            @db.Decimal(7, 1)
  medicionOk          Boolean?
  discrepanciaDetalle String?
  iaPlacasOk          Boolean?
  iaSelloOk           Boolean?
  iaConductorOk       Boolean?
  resultado           ResultadoInspeccion
  creadoEn            DateTime            @default(now())
  fotos               Foto[]
}

model Foto {
  id          String        @id @default(cuid())
  inspeccionId String
  inspeccion  Inspeccion    @relation(fields: [inspeccionId], references: [id])
  categoria   CategoriaFoto
  url         String
  ocrTexto    String?
  ocrValidado Boolean       @default(false)
  tomadaEn    DateTime      @default(now())
}

// ─── Invoices / embarques ─────────────────────────────────────────────────────

model Invoice {
  id              String         @id @default(cuid())
  movimientoId    String
  movimiento      Movimiento     @relation(fields: [movimientoId], references: [id])
  clienteId       String
  cliente         Cliente        @relation(fields: [clienteId], references: [id])
  numeroInvoice   String
  numeroPedimento String
  tscex           String?
  so              String?
  dn              String?
  bl              String?
  lote            String?
  rampaDestino    String?
  atd             DateTime?
  appointment     DateTime?
  wo              String?
  remark          String?
  archivoUrl      String?
  creadoEn        DateTime       @default(now())
  lineas          LineaInvoice[]
}

model LineaInvoice {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  partNumero   String
  descripcion  String
  htsus        String?
  htsusOrigen  String?
  cantidad     Int
  pesoKg       Decimal  @db.Decimal(10, 2)
  numPallets   Int?
  materialCost Decimal? @db.Decimal(12, 2)
  addedValue   Decimal? @db.Decimal(12, 2)
  unitCost     Decimal? @db.Decimal(12, 2)
  extendedCost Decimal? @db.Decimal(12, 2)
}

// ─── Analítica y alertas ──────────────────────────────────────────────────────

model DemandaDiaria {
  id              String        @id @default(cuid())
  transportistaId String
  transportista   Transportista @relation(fields: [transportistaId], references: [id])
  fecha           DateTime
  destino         String
  factoryRequest  Int
  carrierSupplied Int
  diferencia      Int
  razon           String?
  observacion     String?
  trailerNumeros  String[]
}

model Alerta {
  id            String     @id @default(cuid())
  movimientoId  String
  movimiento    Movimiento @relation(fields: [movimientoId], references: [id])
  tipo          TipoAlerta
  mensaje       String
  atendida      Boolean    @default(false)
  atendidaPorId String?
  atendidaPor   Usuario?   @relation("AlertaAtendedor", fields: [atendidaPorId], references: [id])
  creadoEn      DateTime   @default(now())
}

// ─── Usuarios del sistema ─────────────────────────────────────────────────────

model Usuario {
  id                   String       @id @default(cuid())
  nombre               String
  email                String       @unique
  passwordHash         String
  rol                  Rol
  entidadId            String?
  entidadTipo          String?
  activo               Boolean      @default(true)
  solicitudesAprobadas Solicitud[]  @relation("SolicitudAprobador")
  inspecciones         Inspeccion[]
  alertasAtendidas     Alerta[]     @relation("AlertaAtendedor")
}
